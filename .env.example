# ============================================================
# .env.example — Variables d'environnement du projet Recettes
# ============================================================
# Copiez ce fichier en ".env" et renseignez chaque valeur.
# Ne committez JAMAIS le fichier ".env" dans Git.
# Toutes les valeurs ci-dessous sont des exemples/placeholders.
# ============================================================


# ------------------------------------------------------------
# API_KEY — Clé d'authentification partagée entre le frontend
# et le backend (en-tête HTTP X-API-Key).
#
# Format   : chaîne de caractères aléatoires, minimum 32 caractères.
# Exemple  : générez-en une avec la commande :
#              node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Sensibilité : SECRET — ne jamais exposer ni loguer cette valeur.
# ------------------------------------------------------------
API_KEY=remplacez_par_une_cle_aleatoire_dau_moins_32_caracteres


# ------------------------------------------------------------
# GOOGLE_APPLICATION_CREDENTIALS — Chemin vers le fichier JSON
# de compte de service Google Cloud (Service Account Key).
# Ce fichier est nécessaire pour que le backend puisse appeler
# l'API Google Cloud Vision (OCR).
#
# Format   : chemin absolu ou relatif vers un fichier .json
#            téléchargé depuis la console Google Cloud.
# Exemple  : /home/utilisateur/secrets/vision-service-account.json
#            ou, sous Windows : C:\secrets\vision-service-account.json
# Sensibilité : SECRET — ne jammais committer ce fichier dans Git.
# ------------------------------------------------------------
GOOGLE_APPLICATION_CREDENTIALS=/chemin/vers/votre/service-account.json


# ------------------------------------------------------------
# PORT — Port TCP sur lequel le serveur Express écoute.
#
# Format   : entier entre 1024 et 65535.
# Valeur par défaut utilisée si omis : 3000
# ------------------------------------------------------------
PORT=3000


# ------------------------------------------------------------
# UPLOADS_DIR — Dossier de stockage des photos uploadées par
# l'utilisateur (recettes papier photographiées).
#
# Format   : chemin absolu ou relatif (depuis la racine du dossier
#            backend/). Le dossier est créé automatiquement s'il
#            n'existe pas.
# Exemple  : ./uploads  ou  /var/data/recettes/uploads
# Note     : ce dossier est exclu du dépôt Git via .gitignore.
# ------------------------------------------------------------
UPLOADS_DIR=./uploads


# ------------------------------------------------------------
# DB_PATH — Chemin vers le fichier de base de données SQLite.
#
# Format   : chemin absolu ou relatif vers un fichier .db ou .sqlite.
#            Le fichier est créé automatiquement au premier démarrage.
# Exemple  : ./data/recettes.db  ou  /var/data/recettes/db.sqlite
# Note     : ce dossier (data/) est exclu du dépôt Git via .gitignore.
# ------------------------------------------------------------
DB_PATH=./data/recettes.db


# ------------------------------------------------------------
# VITE_API_KEY — Clé API transmise au frontend Vue 3 par Vite.
# Doit être identique à API_KEY.
#
# Pourquoi une variable séparée ?
#   Vite n'expose dans le bundle que les variables dont le nom
#   commence par VITE_. Les autres variables (comme API_KEY) ne
#   sont accessibles que côté serveur Node.js et ne doivent jamais
#   être incluses dans le bundle frontend.
#
# Format      : même valeur que API_KEY (≥ 32 caractères).
# Sensibilité : SECRET — incluse dans le bundle JS compilé.
#               Ne mettez ici que la clé d'accès à votre propre
#               instance — jamais de secrets serveur distincts.
# ------------------------------------------------------------
VITE_API_KEY=remplacez_par_la_meme_valeur_que_API_KEY
